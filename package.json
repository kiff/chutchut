{
  "name": "@kiff/chutchut",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An inbox for AI agents, on your own domain",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild src/lambda/webhook.ts src/lambda/reader.ts src/lambda/stale.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --out-extension:.js=.mjs --external:@aws-sdk/* --sourcemap"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1175.0",
    "@aws-sdk/client-s3": "3.1175.0",
    "@aws-sdk/client-sns": "3.1175.0"
  }
}
